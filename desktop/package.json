{
  "name": "@anda/desktop",
  "private": true,
  "version": "0.16.0",
  "description": "Anda — your local AI workspace",
  "author": "LDC Labs",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/prepare-native.mjs",
    "dev": "electron-vite dev",
    "build": "node scripts/prepare-native.mjs && electron-vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && node node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "node scripts/smoke.mjs",
    "test:onboarding": "node scripts/onboarding-smoke.mjs",
    "package": "pnpm build && node scripts/prepare-runtime.mjs && electron-builder --publish never",
    "package:dir": "pnpm build && node scripts/prepare-runtime.mjs && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.11",
    "node-pty": "1.1.0",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.75.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.6.2",
    "bits-ui": "^2.21.0",
    "chrome-types": "^0.1.464",
    "clsx": "^2.1.1",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "pele": "^1.13.0",
    "playwright": "1.65.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prismjs": "^1.30.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.9.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}