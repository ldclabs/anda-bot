{
  "name": "@anda/desktop",
  "private": true,
  "version": "0.13.1",
  "description": "Anda — your local AI workspace",
  "author": "LDC Labs",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/prepare-native.mjs",
    "dev": "electron-vite dev",
    "build": "node scripts/prepare-native.mjs && electron-vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "node scripts/smoke.mjs",
    "package": "pnpm build && node scripts/prepare-runtime.mjs && electron-builder --publish never",
    "package:dir": "pnpm build && node scripts/prepare-runtime.mjs && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0",
    "ws": "8.20.1"
  },
  "devDependencies": {
    "@antv/g6": "^5.1.1",
    "@antv/layout": "2.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.21.0",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.3",
    "@types/prismjs": "^1.26.6",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.5.0",
    "bits-ui": "^2.18.1",
    "chrome-types": "^0.1.429",
    "clsx": "^2.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "playwright": "1.60.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prismjs": "^1.30.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tslib": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "7.3.1",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0"
  }
